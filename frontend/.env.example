# Environment Variables Template
# Copy to .env.local or set in deployment service environment settings (Render, Vercel, Netlify)

# Base URL of backend API
# If left blank on Vercel, vercel.json automatically proxies /api/* requests to https://military-assest-management-api.onrender.com/api
# If your Render backend URL is different, set VITE_API_URL in Vercel Environment Variables:
# VITE_API_URL=https://military-assest-management-api.onrender.com/api
VITE_API_URL=
